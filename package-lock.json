{
  "name": "obsidian-mcp-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "obsidian-mcp-workspace",
      "workspaces": [
        "obsidian-mcp-brain",
        "mcp-shim"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "mcp-shim": {
      "version": "1.0.0",
      "license": "MIT",
      "bin": {
        "mcp-shim": "mcp-shim.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/mcp-shim": {
      "resolved": "mcp-shim",
      "link": true
    },
    "node_modules/obsidian-mcp-brain": {
      "resolved": "obsidian-mcp-brain",
      "link": true
    },
    "obsidian-mcp-brain": {
      "version": "1.0.0",
      "license": "MIT",
      "bin": {
        "obsidian-mcp-brain": "obsidian-mcp-brain.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
